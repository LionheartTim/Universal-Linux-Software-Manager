{
  "id": "io.github.LionheartTim.UniversalLinuxCenter",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "center-start",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=host:ro",
    "--filesystem=host-os",
    "--filesystem=host-etc",
    "--filesystem=/var/mnt/",
    "--filesystem=xdg-data/applications",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "flatpak-appimage-center",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 main.py /app/bin/main.py",
        "install -Dm644 LICENSE /app/share/licenses/io.github.LionheartTim.UniversalLinuxCenter/LICENSE",
        "install -Dm644 icon.png /app/bin/icon.png",
        "chmod +x /app/bin/main.py",
        "install -Dm644 io.github.LionheartTim.UniversalLinuxCenter.desktop /app/share/applications/io.github.LionheartTim.UniversalLinuxCenter.desktop",
        "install -Dm644 io.github.LionheartTim.UniversalLinuxCenter.metainfo.xml /app/share/metainfo/io.github.LionheartTim.UniversalLinuxCenter.metainfo.xml",
        "install -Dm644 icon-256.png /app/share/icons/hicolor/256x256/apps/io.github.LionheartTim.UniversalLinuxCenter.png",
        "install -Dm644 icon-32.png /app/share/icons/hicolor/32x32/apps/io.github.LionheartTim.UniversalLinuxCenter.png",
        "install -Dm644 icon-48.png /app/share/icons/hicolor/48x48/apps/io.github.LionheartTim.UniversalLinuxCenter.png",
        "install -Dm644 icon-64.png /app/share/icons/hicolor/64x64/apps/io.github.LionheartTim.UniversalLinuxCenter.png",
        "install -Dm644 icon-128.png /app/share/icons/hicolor/128x128/apps/io.github.LionheartTim.UniversalLinuxCenter.png",
        "install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/io.github.LionheartTim.UniversalLinuxCenter.png",
        "echo '#!/bin/sh' > /app/bin/center-start",
        "echo 'PYTHONPATH=\"$(find /app/lib -type d -name site-packages -print -quit)\":$PYTHONPATH exec python3 /app/bin/main.py \"$@\"' >> /app/bin/center-start",
        "chmod +x /app/bin/center-start"
      ],
      "sources": [
        {
          "type": "file",
          "path": "main.py"
        },
        {
          "type": "file",
          "path": "icon.png"
        },
        {
          "type": "file",
          "path": "icon-32.png"
        },
        {
          "type": "file",
          "path": "icon-48.png"
        },
        {
          "type": "file",
          "path": "icon-64.png"
        },
        {
          "type": "file",
          "path": "icon-128.png"
        },
        {
          "type": "file",
          "path": "icon-256.png"
        },
        {
          "type": "file",
          "path": "io.github.LionheartTim.UniversalLinuxCenter.desktop"
        },
        {
          "type": "file",
          "path": "io.github.LionheartTim.UniversalLinuxCenter.metainfo.xml"
        },
        {
          "type": "file",
          "path": "LICENSE"
        }
      ]
    }
  ],
  "base": "com.riverbankcomputing.PyQt.BaseApp",
  "base-version": "6.10",
  "build-options": {
    "env": {
      "BASEAPP_REMOVE_WEBENGINE": "1"
    }
  },
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ]
}
